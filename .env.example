# Slack credentials (from your Slack app settings)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-level-token
SLACK_SIGNING_SECRET=your-signing-secret

# Your Slack user ID (click your profile > ⋮ > Copy member ID)
OWNER_USER_ID=UXXXXXXXX

# Channel ID of your public channel (used by /join)
PUBLIC_CHANNEL_ID=CXXXXXXXX

# Channel ID of your private channel (invited to when you accept /joinprvt)
PRIVATE_CHANNEL_ID=GXXXXXXXX

# Where the bot stores join requests and movie requests
DATA_FILE=data/db.json

# AI tutor (Anthropic). Get a key at console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key
# Optional: override the model used by the tutor
# ANTHROPIC_MODEL=claude-sonnet-4-5
